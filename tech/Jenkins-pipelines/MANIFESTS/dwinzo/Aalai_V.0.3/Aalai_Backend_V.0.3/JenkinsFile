pipeline {
    agent {
        label 'remote-server-agent'
    }
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on $ref by $author',
            token: 'dwinzoOrgDwinzoBackend',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/Bkd_9901$'
        )
    }
    environment {
        GIT_CREDENTIALS = credentials('ramkumarp')
        DOCKER_COMPOSE = 'docker-compose'
        COMPOSE_PROJECT_NAME = 'aalai_backend_demo'
        MAIN_CONTAINER = 'aalai_demo_api_end'
        SOCKET_CONTAINER = 'aalai_demo_socket_end'
        MONGO_CONTAINER = 'aalai_demo_mongo'
        GRAFANA_CONTAINER = 'grafana'
        PROMETHEUS_CONTAINER = 'prometheus'
        NETWORK_NAME = 'DwinzoMajor'
        SMTP_CREDENTIALS = credentials('smtp-credentials-gmail')
    }
    stages {
        stage('Source') {
            steps {
                cleanWs(deleteDirs: true, disableDeferredWipeout: true)
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/Bkd_9901']],
                        userRemoteConfigs: [[
                            url: 'http://ramkumar@hexrfactory.com:Ramkumar@123@127.0.0.0:7778/Dwinzo/Dwinzo-Backend.git',
                            credentialsId: env.GIT_CREDENTIALS
                        ]]
                    ])
                }
            }
        }
        stage('Build & Clean Old Containers') {
            steps {
                script {
                    powershell '''
                        Write-Host "Cleaning old containers..."
                        foreach ($container in @("$env:MAIN_CONTAINER", "$env:SOCKET_CONTAINER", "$env:MONGO_CONTAINER", "$env:GRAFANA_CONTAINER", "$env:PROMETHEUS_CONTAINER")) {
                            $cid = docker ps -aq -f "name=$container"
                            if ($cid) {
                                docker stop $cid | Out-Null
                                docker rm $cid | Out-Null
                            }
                        }
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        $env:COMPOSE_PROJECT_NAME = "$env:COMPOSE_PROJECT_NAME"
                        docker-compose down --remove-orphans 2>$null
                        Write-Host "Old containers removed."
                    '''
                    powershell '''
                        Write-Host "Building all containers..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        $env:COMPOSE_PROJECT_NAME = "$env:COMPOSE_PROJECT_NAME"
                        docker-compose build --no-cache
                    '''
                }
            }
        }
        stage('Deploy All Services') {
            steps {
                script {
                    powershell '''
                        Write-Host "Deploying API, Socket, Mongo, Prometheus, Grafana..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        $env:COMPOSE_PROJECT_NAME = "$env:COMPOSE_PROJECT_NAME"
                        docker-compose up -d
                        Start-Sleep -Seconds 30
                        Write-Host "Containers deployed successfully."
                    '''
                }
            }
        }
    }
    post {
        always {
            script {
                // Safely define dynamic values
                def buildResult = currentBuild.result ?: 'SUCCESS'
                def buildNumber = env.BUILD_NUMBER
                def buildDuration = currentBuild.durationString.replace(' and counting', '')
                def buildTime = new Date().format("MMM dd, yyyy - HH:mm")
                def branchName = ref ? ref.replace('refs/heads/', '') : 'N/A'
                def lastCommit = commit ? commit.substring(0, 7) : 'N/A'
                def triggerAuthor = author ?: 'N/A'
                def currentYear = new Date().format("yyyy")

