                        border-left-color: #F44336;
                        background-color: #FFEBEE;
                    }
                    .status-unstable {
                        border-left-color: #FF9800;
                        background-color: #FFF3E0;
                    }
                    .section {
                        margin-bottom: 25px;
                    }
                    .section-title {
                        color: #2B7A78;
                        border-bottom: 2px solid #DEF2F1;
                        padding-bottom: 8px;
                        margin-top: 0;
                        font-size: 18px;
                    }
                    .info-grid {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
