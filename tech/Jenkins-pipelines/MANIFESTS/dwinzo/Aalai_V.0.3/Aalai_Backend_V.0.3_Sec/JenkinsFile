                        margin-top: 10px;
                    }
                    .status-pass {
                        background-color: #E8F5E9;
                        color: #4CAF50;
                    }
                    .status-fail {
                        background-color: #FFEBEE;
                        color: #F44336;
                    }
                    .status-warn {
                        background-color: #FFF3E0;
                        color: #FF9800;
                    }
                    .footer {
                        background-color: #17252A;
                        color: #FFFFFF;
                        padding: 15px;
                        text-align: center;
                        font-size: 12px;
                    }
                    .button {
                        display: inline-block;
                        background-color: #3AAFA9;
                        color: white;
                        padding: 10px 20px;
                        text-decoration: none;
                        border-radius: 4px;
                        margin-top: 10px;
                        font-weight: bold;
                    }
                    .artifact-list {
                        background-color: #F9F9F9;
                        border-radius: 4px;
                        padding: 15px;
                        margin-top: 15px;
                    }
                    .artifact-item {
                        margin-bottom: 8px;
                        display: flex;
                        align-items: center;
                    }
                    .artifact-icon {
                        margin-right: 10px;
                        color: #2B7A78;
                    }
                </style>
            </head>
            <body>
                <div class="container">
                    <div class="header">
                        <h1>🛡️ Aalai Backend V.0.3 Security Scan</h1>
                        <p>Build #${env.BUILD_NUMBER} | ${new Date().format("MMM dd, yyyy - HH:mm")}</p>
                    </div>
                    
                    <div class="content">
                        <div class="status-banner ${currentBuild.result ? currentBuild.result.toLowerCase() : 'status-success'}">
                            <h2 style="margin: 0;">Build Status: ${currentBuild.result ?: 'SUCCESS'}</h2>
                            <p style="margin: 10px 0 0;">
                                Triggered by commit on ${ref} by ${author}
                                ${commit ? '<br>Commit: ' + commit.substring(0, 7) : ''}
                            </p>
                        </div>
                        
                        <div class="section">
                            <h3 class="section-title">Build Information</h3>
                            <div class="info-grid">
                                <div class="info-item">
                                    <div class="info-label">Project Name</div>
                                    <div>Aalai Backend V.0.3</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Build Number</div>
                                    <div>#${env.BUILD_NUMBER}</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Branch</div>
                                    <div>${ref ? ref.replace('refs/heads/', '') : 'N/A'}</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Build Duration</div>
                                    <div>${currentBuild.durationString.replace(' and counting', '')}</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Built On</div>
                                    <div>remote-server-agent</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Jenkins URL</div>
                                    <div><a href="${env.BUILD_URL}" style="color: #3AAFA9;">View Build</a></div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="section">
                            <h3 class="section-title">Security Scan Results</h3>
                            <div class="scan-results">
                                <div class="scan-card">
                                    <h3>🔍 Trivy Image Scan</h3>
                                    <p>Container vulnerability assessment</p>
                                    <span class="scan-status status-pass">Completed</span>
                                </div>
                                <div class="scan-card">
                                    <h3>🔑 Gitleaks Secret Scan</h3>
                                    <p>Detected secrets in codebase</p>
                                    <span class="scan-status status-pass">Completed</span>
                                </div>
                                <div class="scan-card">
                                    <h3>📊 SonarQube Analysis</h3>
                                    <p>Code quality & security inspection</p>
                                    <span class="scan-status status-pass">Completed</span>
                                </div>
                                <div class="scan-card">
                                    <h3>🧩 Dependency Check</h3>
                                    <p>Software composition analysis</p>
                                    <span class="scan-status status-pass">Completed</span>
                                </div>
                            </div>
                            
                            <div style="margin-top: 20px;">
                                <a href="${env.BUILD_URL}" class="button">View Full Build Details</a>
                            </div>
                        </div>
                        
                        <div class="section">
                            <h3 class="section-title">Available Artifacts</h3>
                            <div class="artifact-list">
                                <div class="artifact-item">
                                    <span class="artifact-icon">📄</span>
                                    <span>SCA Report (Dependency-Check): dependency-check-report.html</span>
                                </div>
                                <div class="artifact-item">
                                    <span class="artifact-icon">📄</span>
                                    <span>Secret Scan Report: gitleaks-report.sarif</span>
                                </div>
                                <div class="artifact-item">
                                    <span class="artifact-icon">📄</span>
                                    <span>Container Scan Reports: trivy-reports/*.sarif</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="footer">
                        <p>This is an automated message from Jenkins CI/CD System. Please do not reply to this email.</p>
                        <p>© ${new Date().format("yyyy")} HexaFactory - All Rights Reserved</p>
                    </div>
                </div>
            </body>
            </html>
            """
            
            emailext(
                subject: "🛡️ Aalai Backend V.0.3 Security Scan - Build ${env.BUILD_NUMBER} | Status: ${currentBuild.result ?: 'SUCCESS'}",
                body: emailBody,
                to: "marikannan@hexrfactory.com, rithish@hexrfactory.com, sabarinathan@hexrfactory.com, nivetha@hexrfactory.com, ramkumar@hexrfactory.com",
                mimeType: 'text/html',
                replyTo: "marikannan@hexrfactory.com",
                from: '$SMTP_CREDENTIALS_USR',
                attachmentsPattern: "sca-report/dependency-check-report.html, gitleaks-reports/*.sarif, trivy-reports/*.sarif"
            )
            archiveArtifacts artifacts: 'sca-report/dependency-check-report.html', allowEmptyArchive: true
            archiveArtifacts artifacts: 'gitleaks-reports/gitleaks-report.sarif', allowEmptyArchive: true
            archiveArtifacts artifacts: 'trivy-reports/*.sarif', allowEmptyArchive: true
            cleanWs(deleteDirs: true, disableDeferredWipeout: true)
        }
    }
  }
}
