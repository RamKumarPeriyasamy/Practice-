pipeline {
    agent {
        label 'remote-server-agent'
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on $ref by $author',
            token: 'dwinzoBetaDwinzoDemo',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/main-demo$'
        )
    }

    environment {
        GIT_CREDENTIALS   = credentials('ramkumarp')
        SONAR_HOST_URL    = 'http://127.0.0.0:12345'
        SONAR_TOKEN       = credentials('sonarqube-token')
        SMTP_CREDENTIALS  = credentials('smtp-credentials-gmail')
    }

    stages {
        stage('Source') {
            steps {
                script {
                    cleanWs(deleteDirs: true, disableDeferredWipeout: true)
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main-demo']],
                        userRemoteConfigs: [[
                            url: 'http://127.0.0.0:7778/Dwinzo-Beta/Dwinzo_Demo.git',
                            credentialsId: env.GIT_CREDENTIALS
                        ]]
                    ])
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    powershell '''
                        Write-Host "Starting Docker build..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose build --no-cache
                        docker images
                    '''
                }
            }
        }

        stage('Image Scan with Trivy') {
            steps {
                script {
                    powershell '''
                        Write-Host "Running Trivy scan..."
                        if (-not (Test-Path ".\\frontend-trivy-reports")) {
                            New-Item -ItemType Directory -Path ".\\frontend-trivy-reports" | Out-Null
                        }
                        $images = @("aalaiDemoTwo:latest")
                        foreach ($image in $images) {
                            $imageExists = docker images --format "{{.Repository}}:{{.Tag}}" | Select-String -Pattern "^$image$"
                            if (-not $imageExists) { continue }
                            C:\\Tools\\Trivy\\trivy.exe image `
                                --severity HIGH,CRITICAL `
                                --format sarif `
                                --output ".\\frontend-trivy-reports\\$($image.Replace(':', '_')).sarif" `
                                $image
                        }
                        Write-Host "Trivy scan completed."
                    '''
                }
            }
        }

        stage('Secret Scanning with Gitleaks') {
            steps {
                script {
                    powershell '''
                        Write-Host "Running Gitleaks scan..."
                        if (-not (Test-Path ".\\frontend-gitleaks-reports")) {
                            New-Item -ItemType Directory -Path ".\\frontend-gitleaks-reports" | Out-Null
                        }
                        C:\\Tools\\Gitleaks\\gitleaks.exe detect `
                            --source ./ `
                            --report-format sarif `
                            --report-path ".\\frontend-gitleaks-reports\\gitleaks-report.sarif"
                        Write-Host "Gitleaks scan completed."
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    powershell '''
                        Write-Host "Preparing SonarQube properties..."
                        $sonarProps = @"
sonar.projectKey=Aalai_Fronend_V.0.3
sonar.projectName=Aalai_Fronend_V.0.3
sonar.projectVersion=1.0.0
sonar.sources=./app/
sonar.language=ts
sonar.typescript.lcov.reportPaths=coverage/lcov.info
"@
                        Set-Content -Path "sonar-project.properties" -Value $sonarProps
                        Write-Host "Running SonarScanner..."
                        sonar-scanner
                    '''
                }
            }
        }
    }

    post {
