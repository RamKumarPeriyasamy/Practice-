                        </head>
                        <body>
                            <div class="container">
                                <div class="header">
                                    <h1>Aalai Frontend <span class="version-tag" style="background: rgba(255,255,255,0.2); color: white;">V.0.3</span></h1>
                                    <p>Advanced Build Notification System</p>
                                </div>
                                
                                <div class="content">
                                    <div class="status-card ${buildResult == 'SUCCESS' ? 'status-success' : 'status-failure'}">
                                        <div class="status-icon">${statusIcon}</div>
                                        <div class="status-title">Build ${env.BUILD_NUMBER} - ${buildResult}</div>
                                        <div class="accent-line"></div>
                                        <p class="status-subtitle">${buildResult == 'SUCCESS' ? 'Your build completed successfully and is ready for deployment' : 'The build process encountered an error - please check the logs for details'}</p>
