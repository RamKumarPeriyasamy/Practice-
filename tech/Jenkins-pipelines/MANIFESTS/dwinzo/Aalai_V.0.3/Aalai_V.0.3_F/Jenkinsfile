pipeline {
    agent {
        label 'remote-server-agent'
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on $ref by $author',
            token: 'dwinzoBetaDwinzoDemo',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/main-demo$'
        )
    }

    environment {
        GIT_CREDENTIALS = credentials('ramkumarp')
        DOCKER_COMPOSE = 'docker-compose'
        APP_NAME = 'Dwinzo-Beta/aalai_Demo_2'
        MAIN_CONTAINER = 'aalaiDemoTwo'
        WEBSITE_URL = 'http://127.0.0.0:8400'
        SMTP_CREDENTIALS = credentials('smtp-credentials-gmail')
    }

    stages {
        stage('Source') {
            steps {
                cleanWs(deleteDirs: true)
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main-demo']],
                    userRemoteConfigs: [[
                        url: 'http://127.0.0.0:7778/Dwinzo-Beta/Dwinzo_Demo.git',
                        credentialsId: env.GIT_CREDENTIALS
                    ]]
                ])
            }
        }

        stage('Build') {
            steps {
                script {
                    powershell '''
                        docker-compose build --no-cache
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    powershell '''
                        Write-Host "♻️ Stopping and removing old container if it exists..."
                        $containerExists = docker ps -a -q -f "name=$env:MAIN_CONTAINER"
                        if ($containerExists) {
                            docker stop $env:MAIN_CONTAINER | Out-Null
                            docker rm -f $env:MAIN_CONTAINER | Out-Null
                            Write-Host "🧹 Old container stopped and removed."
                        } else {
                            Write-Host "ℹ️ No old container found. Proceeding with deployment."
                        }

                        Write-Host "🧹 Cleaning up unused Docker networks..."
                        docker network prune -f | Out-Null

                        Write-Host "🚀 Starting new container from the freshly built image..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose up -d

                        Start-Sleep -Seconds 10

                        $mainContainer = docker ps -q -f "name=$env:MAIN_CONTAINER"
                        if (-not $mainContainer) {
                            Write-Error "❌ Main application container ($env:MAIN_CONTAINER) not found after deployment."
                            exit 1
                        }

                        Write-Host "✅ Application deployed successfully!"
                        Write-Host "📦 Container ID: $mainContainer"
                        docker logs $mainContainer
                        docker ps
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                def buildResult = currentBuild.result ?: 'SUCCESS'
                def statusIcon = buildResult == 'SUCCESS' ? '✅' : '❌'
                def date = new Date()
                
                emailext(
                    subject: "${statusIcon} Aalai Frontend V.0.3 - Build ${env.BUILD_NUMBER} | ${buildResult}",
                    body: """
                        <!DOCTYPE html>
                        <html lang="en">
                        <head>
                            <meta charset="UTF-8">
                            <meta name="viewport" content="width=device-width, initial-scale=1.0">
                            <title>Build Notification - Aalai Frontend V.0.3</title>
                            <style>
                                * { 
                                    margin: 0; 
                                    padding: 0; 
                                    box-sizing: border-box; 
                                    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
                                }
                                body { 
                                    background: linear-gradient(135deg, #154ESE 0%, #71B280 50%, #E8F5E8 100%);
