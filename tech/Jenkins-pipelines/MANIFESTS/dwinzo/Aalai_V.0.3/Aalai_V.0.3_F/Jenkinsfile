                                    <div style="margin-top: 15px; padding-top: 10px; border-top: 1px solid rgba(113, 178, 128, 0.2);">
                                        <p style="margin: 5px 0; font-size: 12px;">Primary Contact: <a href="mailto:marikannan@hexrfactory.com" style="color: #154ESE; text-decoration: none; font-weight: 600;">marikannan@hexrfactory.com</a></p>
