                    to: "marikannan@hexrfactory.com, vishnu@hexrfactory.com, rithish@hexrfactory.com, jerald@hexrfactory.com, ramkumar@hexrfactory.com",
                    attachLog: true,
                    mimeType: 'text/html',
                    replyTo: "marikannan@hexrfactory.com",
                    from: '$SMTP_CREDENTIALS_USR'
                )
            }
        }
    
        success {
            powershell '''
                Write-Host "✅ Deployment successful!"
            '''
        }
    
        failure {
            powershell '''
                Write-Host "❌ Deployment failed."
            '''
        }
    }
}
