// Pipeline script for Windows environment using PowerShell
// Handles Node.js app deployment with Docker Compose using POLLSCM
pipeline {
    agent {
        label 'remote-server-agent'
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on $ref by $author',
            token: 'marketplace-Frontend-webhook',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/feature/dwinzo-update$'
        )
    }

    environment {
        GIT_CREDENTIALS = credentials('rithishsamm')
        MAIN_CONTAINER = 'marketplace-frontend'
    }

    stages {
        stage('Source') {
            steps {
                cleanWs()
                script {
                    powershell '''
                        Write-Host "Starting source stage..."
                    '''

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/feature/dwinzo-update']],
                        userRemoteConfigs: [[
                            url: 'http://ramkumar@hexrfactory.com:Ramkumar@123@127.0.0.0:7778/Marketplace/MarketPlace_FrontEnd.git',
                            
                        ]]
                    ])

                    powershell '''
                        Write-Host "Source checkout completed successfully"
                        dir
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    powershell '''
                        Write-Host "Starting Docker Compose build..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose build --no-cache
                        dir
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    powershell """
                        Write-Host "Cleaning up old container if it exists..."

                        \$containerExists = docker ps -a -q -f "name=${env.MAIN_CONTAINER}"
                        if (\$containerExists) {
                            Write-Host "Stopping and removing existing container: ${env.MAIN_CONTAINER}"
                            docker stop ${env.MAIN_CONTAINER}
                            docker rm ${env.MAIN_CONTAINER}
                        } else {
                            Write-Host "No existing container found, skipping removal."
                        }

                        Write-Host "Starting deployment with Docker Compose..."
                        \$env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose up -d --build

                        Start-Sleep -Seconds 10

                        Write-Host "Verifying container status..."
                        \$containerId = docker ps -q -f "name=${env.MAIN_CONTAINER}"
                        if (-not \$containerId) {
                            Write-Error "❌ Application container (${env.MAIN_CONTAINER}) not found after deployment"
                            exit 1
                        }

                        Write-Host "✅ Application deployed successfully!"
                        Write-Host "Container ID: \$containerId"
                        docker logs \$containerId
                        docker ps
                    """
                }
            }
        }
    }

    post {
        success {
            powershell '''
                Write-Host "✅ Pipeline completed successfully!"
                Write-Host "Build Number: $env:BUILD_NUMBER"
                Write-Host "Workspace: $env:WORKSPACE"
                Write-Host "Triggered by commit: $env:commit"
                Write-Host "Author: $env:author"
            '''
        }
        failure {
            powershell '''
                Write-Host "❌ Pipeline failed!"
                Write-Host "Check the logs above for details."
                Write-Host "Triggered by commit: $env:commit"
                Write-Host "Author: $env:author"
                docker ps -a
            '''
        }
        always {
            cleanWs()
        }
    }
}
