pipeline {
    agent {
        label 'remote-server-agent'
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on $ref by $author',
            token: 'marketplace-Frontend-webhook',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/feature/dwinzo-update$'
        )
    }

    environment {
        GIT_CREDENTIALS = credentials('rithishsamm')
        SONAR_HOST_URL = 'http://127.0.0.0:12345'
        SONAR_TOKEN = credentials('sonarqube-token')
        SMTP_CREDENTIALS_USR = credentials('smtp-credentials-gmail')
    }

    stages {
        stage('Source') {
            steps {
                cleanWs()
                script {
                    powershell '''
                        Write-Host "Starting source stage..."
                    '''

                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/feature/dwinzo-update']],
                        userRemoteConfigs: [[
                            url: 'http://ramkumar@hexrfactory.com:Ramkumar@123@127.0.0.0:7778/Marketplace/MarketPlace_FrontEnd.git',
                        ]]
                    ])

                    powershell '''
                        Write-Host "Source checkout completed successfully"
                        dir
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    powershell '''
                        Write-Host "Starting Docker Compose build..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose build --no-cache
                        dir
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    powershell '''
                        Write-Host "Generating sonar-project.properties..."
                        $sonarProps = @"
sonar.projectKey=Marketplace_Dwinzo
sonar.projectName=Marketplace_Dwinzo
sonar.projectVersion=1.0.0
sonar.projectDescription=This is a main project for Marketplace Dwinzo.
sonar.sources=./frontend/
sonar.language=js
sonar.javascript.lcov.reportPaths=coverage/lcov.info
"@
                        Set-Content -Path "sonar-project.properties" -Value $sonarProps
                        Write-Host "Running SonarScanner..."
                        sonar-scanner
                    '''
                }
            }
        }
    }

