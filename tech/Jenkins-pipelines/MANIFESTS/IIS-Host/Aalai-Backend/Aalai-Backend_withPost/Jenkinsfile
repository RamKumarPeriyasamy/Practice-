pipeline {
    agent {
        label 'remote-server-agent'
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on ${ref} by ${author}',
            token: 'aalaiStaticBackend',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/main$'
        )
    }

    environment {
        GIT_CREDENTIALS = credentials('ramkumarp')
        DOCKER_COMPOSE = 'docker-compose'
        COMPOSE_PROJECT_NAME = 'dwinzo-backend'
        MAIN_CONTAINER = 'aalaiDemoApiBackend'
        SOCKET_CONTAINER = 'aalaiDemoSocketBackend'
        MONGO_CONTAINER = 'aalaiDemoMongo'
        GRAFANA_CONTAINER = 'aalaiDemoGrafana'
        PROMETHEUS_CONTAINER = 'aalaiDemoPrometheus'
        MONGO_EXPORTER_CONTAINER = 'aalaiDemoMongoExporter'
        NETWORK_NAME = 'DwinzoMajor'
        SMTP_CREDENTIALS = credentials('smtp-credentials-gmail')
        WEBSITE_URL = ''
    }

    stages {
        stage('Source') {
            steps {
                cleanWs(deleteDirs: true, disableDeferredWipeout: true)
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: '',
                            credentialsId: env.GIT_CREDENTIALS_ID
                        ]]
                    ])
                }
            }
        }

        stage('Build & Clean Old Containers') {
            steps {
                script {
                    powershell '''
                        Write-Host "Cleaning old containers..."
                        $containers = "$env:MAIN_CONTAINER", "$env:SOCKET_CONTAINER", "$env:MONGO_CONTAINER", "$env:GRAFANA_CONTAINER", "$env:PROMETHEUS_CONTAINER", "$env:MONGO_EXPORTER_CONTAINER"
                        foreach ($container in $containers) {
                            $cid = docker ps -aq -f "name=$container"
                            if ($cid) {
                                Write-Host "Stopping and removing container: $container"
                                docker stop $cid 2>$null
                                docker rm $cid 2>$null
                            }
                        }
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        $env:COMPOSE_PROJECT_NAME = "$env:COMPOSE_PROJECT_NAME"
                        docker-compose down --remove-orphans 2>$null
                        Write-Host "Old containers removed."
                    '''

                    powershell '''
                        Write-Host "Building all containers..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        $env:COMPOSE_PROJECT_NAME = "$env:COMPOSE_PROJECT_NAME"
                        docker-compose build --no-cache
                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker compose build failed"
                        }
                    '''
                }
            }
        }

        stage('Deploy All Services') {
            steps {
                script {
                    powershell '''
                        Write-Host "Deploying all services..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        $env:COMPOSE_PROJECT_NAME = "$env:COMPOSE_PROJECT_NAME"
                        docker-compose up -d
                        if ($LASTEXITCODE -ne 0) {
                            throw "Docker compose up failed"
                        }
                        Write-Host "Waiting for services to start..."
                        Start-Sleep -Seconds 30
                        
                        Write-Host "Checking container status..."
                        docker ps -a --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"
                        
                        Write-Host "Containers deployed successfully."
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    powershell '''
                        Write-Host "Performing health checks..."
                        $apiHealth = try { Invoke-WebRequest -Uri "http://127.0.0.0:9911/health" -UseBasicParsing -TimeoutSec 10 } catch { $null }
                        if ($apiHealth -and $apiHealth.StatusCode -eq 200) {
                            Write-Host "✅ API Service is healthy"
                        } else {
                            Write-Host "⚠️ API Service health check failed"
                        }
                        
                        Write-Host "Service Endpoints:"
                        Write-Host "API Service: http://127.0.0.0:9911"
                        Write-Host "Socket Service: http://127.0.0.0:9912"
                        Write-Host "MongoDB: http://127.0.0.0:9913"
                        Write-Host "Grafana Dashboard: http://127.0.0.0:5611"
                        Write-Host "Prometheus: http://127.0.0.0:6711"
                        Write-Host "Mongo Exporter: http://127.0.0.0:9211"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                def buildResult = currentBuild.result ?: 'SUCCESS'
                def statusClass = (buildResult == 'SUCCESS') ? 'success' : (buildResult == 'FAILURE') ? 'failure' : 'warning'
                def statusIcon = (buildResult == 'SUCCESS') ? '✅' : (buildResult == 'FAILURE') ? '❌' : '⚠️'
                def buildNumber = env.BUILD_NUMBER ?: 'Unknown'
                def buildDuration = currentBuild.durationString?.replace(' and counting', '') ?: 'Unknown'
                def branchName = env.ref ? env.ref.replace('refs/heads/', '') : 'main'
                def lastCommit = env.commit ? env.commit.substring(0, 7) : 'N/A'
