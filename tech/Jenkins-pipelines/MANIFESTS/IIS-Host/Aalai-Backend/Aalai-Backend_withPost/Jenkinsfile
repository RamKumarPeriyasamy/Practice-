            }
        }

        success {
            powershell '''
                Write-Host "✅ Aalai Static Backend Pipeline completed successfully!"
                Write-Host "Build Number: $env:BUILD_NUMBER"
                Write-Host "API Service: http://127.0.0.0:9911"
                Write-Host "Socket Service: http://127.0.0.0:9912"
                Write-Host "Grafana Dashboard: http://127.0.0.0:5611"
                Write-Host "Triggered by: $env:author"
            '''
        }

        failure {
            powershell '''
                Write-Host "❌ Aalai Static Backend Pipeline failed!"
                Write-Host "Check logs for details"
                Write-Host "Build Number: $env:BUILD_NUMBER"
                Write-Host "Current container status:"
                docker ps -a
            '''
        }
    }
}