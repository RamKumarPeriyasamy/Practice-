                            <div class="info-label" style="font-size:12px; color:#596235; text-transform:uppercase; font-weight:700; margin-bottom:8px; letter-spacing:0.5px;">Triggered By</div>
                            <div class="info-value" style="font-size:17px; color:#2c3e50; font-weight:600;">${env.author ?: 'Unknown'}</div>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td width="50%" style="padding-right:10px;">
                        <div class="info-card" style="background:linear-gradient(135deg, rgba(217,104,70,0.05) 0%, rgba(89,98,53,0.05) 100%); padding:25px; border-radius:15px; border-left:5px solid #D96846;">
                            <div class="info-label" style="font-size:12px; color:#596235; text-transform:uppercase; font-weight:700; margin-bottom:8px; letter-spacing:0.5px;">Branch</div>
