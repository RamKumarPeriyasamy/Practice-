        <div class="content" style="padding:45px 35px;">
            <div class="greeting" style="font-size:20px; color:#D96846; margin-bottom:25px; font-weight:600;">👋 Hello Development Team,</div>
            <p class="main-text" style="font-size:16px; color:#596235; margin-bottom:30px; line-height:1.7;">
                ${buildResult == 'SUCCESS' ? 
                    'Your latest deployment has been processed successfully. Here\'s a comprehensive overview of the build and deployment status.' : 
                    'Your build has encountered an issue. Please review the details below and take necessary action.'}
            </p>

            <!-- Info Grid -->
            <table width="100%" style="margin:35px 0;" cellpadding="0" cellspacing="0">
                <tr>
                    <td width="50%" style="padding-right:10px;">
                        <div class="info-card" style="background:linear-gradient(135deg, rgba(217,104,70,0.05) 0%, rgba(89,98,53,0.05) 100%); padding:25px; border-radius:15px; border-left:5px solid #D96846;">
                            <div class="info-label" style="font-size:12px; color:#596235; text-transform:uppercase; font-weight:700; margin-bottom:8px; letter-spacing:0.5px;">Repository</div>
