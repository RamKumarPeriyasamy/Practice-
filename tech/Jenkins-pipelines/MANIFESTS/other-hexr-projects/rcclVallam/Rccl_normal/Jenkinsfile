            </table>

            <!-- Highlight -->
            <div class="highlight" style="background:${buildResult == 'FAILURE' ? 'linear-gradient(135deg, rgba(217,104,70,0.1) 0%, rgba(220,53,69,0.1) 100%)' : 'linear-gradient(135deg, rgba(89,98,53,0.1) 0%, rgba(217,104,70,0.1) 100%)'}; padding:30px; border-radius:16px; margin:30px 0; border-left:5px solid ${buildResult == 'FAILURE' ? '#D96846' : '#596235'}; box-shadow:0 8px 25px rgba(${buildResult == 'FAILURE' ? '217,104,70' : '89,98,53'},0.1);">
