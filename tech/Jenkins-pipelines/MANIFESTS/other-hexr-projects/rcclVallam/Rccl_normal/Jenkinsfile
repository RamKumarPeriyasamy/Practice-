<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RCCL Vallam ${titleText}</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .container { max-width: 700px; margin: 0 auto; }
        .btn { text-decoration: none !important; display: inline-block; }
    </style>
</head>
<body style="margin:0; padding:20px; background:linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #2c3e50;">
    <div class="container" style="max-width:700px; margin:0 auto; background:white; border-radius:20px; overflow:hidden; box-shadow:0 25px 50px rgba(217,104,70,0.15); border:1px solid rgba(89,98,53,0.1);">
        
        <!-- Header -->
        <div class="header" style="background:linear-gradient(135deg, #D96846 0%, #596235 100%); padding:40px 30px; text-align:center; color:white; position:relative;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:20px;">
                <div></div>
                <div class="website-tag" style="background:rgba(255,255,255,0.25); padding:8px 16px; border-radius:20px; font-size:11px; color:white; font-weight:600; backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.3);">
                    <a href="${env.WEBSITE_URL}" target="_blank" style="color:white; text-decoration:none;">RCCL Vallam Project</a>
                </div>
            </div>
            <div class="logo" style="background:rgba(255,255,255,0.15); display:inline-block; padding:20px 28px; border-radius:16px; margin-bottom:25px;">
                <div class="logo-text" style="font-size:24px; font-weight:700; letter-spacing:2px; color:white;">RCCL</div>
                <div class="logo-subtitle" style="font-size:12px; opacity:0.9; color:rgba(255,255,255,0.9);">Vallam Project</div>
