pipeline {
    agent {
        label 'remote-server-agent'
    }
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on $ref by $author',
            token: 'rcclvallamproject001',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/main$'
        )
    }
    environment {
        GIT_CREDENTIALS = credentials('ramkumarp')
        DOCKER_COMPOSE = 'docker-compose'
        APP_NAME = 'vishnu/rccl_vallam_project'
        MAIN_CONTAINER = 'rccl_vallam' 
        SONAR_HOST_URL = 'http://127.0.0.0:12345'
        SONAR_TOKEN = credentials('sonarqube-token')  
        SMTP_CREDENTIALS = credentials('smtp-credentials-gmail')
        WEBSITE_URL = 'http://127.0.0.0:4080'
    }

    stages {
        stage('Source') {
                steps {
                    cleanWs(deleteDirs: true, disableDeferredWipeout: true)
                    script {
                        powershell '''
                            Write-Host "📥 Fetching latest source code..."
                        '''
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: '*/main']],
                            userRemoteConfigs: [[
                                url: 'http://127.0.0.0:7778/Vishnu/rccl_vallam_project.git',
                                credentialsId: env.GIT_CREDENTIALS
                            ]],
                            extensions: [
                                [$class: 'WipeWorkspace'],
                                [$class: 'CloneOption', depth: 1, shallow: false, noTags: true, timeout: 10]
                            ]
                        ])
            
                        // ✅ Use PowerShell instead of sh (Windows-safe)
                        powershell '''
                            Write-Host "🔄 Ensuring we are on latest commit..."
                            git fetch --all
                            git reset --hard origin/main
                            $commitHash = git rev-parse HEAD
                            Write-Host "✅ Building commit: $commitHash"
                        '''
                    }
                }
            }
   


        stage('Build') {
            steps {
                script {
                    powershell '''
                        Write-Host "🛠️ Building Docker image without affecting existing container..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose build --no-cache
                        if ($LASTEXITCODE -ne 0) {
                            Write-Error "❌ Docker build failed!"
                            exit 1
                        }
                        Write-Host "✅ Build completed. Existing container still running."
                    '''
                }
            }
        }


stage('SonarQube Analysis') {
            steps {
                script {
                    powershell '''
                        Write-Host "Checking project structure for SonarQube..."
                        $sourceDirs = @()
                        if (Test-Path "./src") { $sourceDirs += "./src" }
                        if (Test-Path "./app") { $sourceDirs += "./app" }
                        if (Test-Path "./components") { $sourceDirs += "./components" }
                        if (Test-Path "./pages") { $sourceDirs += "./pages" }
                        if ($sourceDirs.Count -eq 0) { $sourceDirs += "." }
                        $sourceString = $sourceDirs -join ","
                        Write-Host "Using sources: $sourceString"

                        $sonarProps = @"
sonar.projectKey=RCCL_Vallam_Project
sonar.projectName=RCCL_Vallam_Project
sonar.projectVersion=1.0.0
sonar.projectDescription=RCCL Vallam Project
sonar.sources=$sourceString
sonar.language=js
sonar.javascript.lcov.reportPaths=coverage/lcov.info
sonar.exclusions=**/node_modules/**,**/dist/**,**/build/**,**/public/**,**/*.min.js,**/vendor/**,**/coverage/**
"@
                        Set-Content -Path "sonar-project.properties" -Value $sonarProps
                        Write-Host "SonarQube configuration written."

                        Write-Host "Starting SonarQube analysis..."
                        sonar-scanner
                        Write-Host "SonarQube analysis completed."
                    '''
                }
            }
        }
        
        stage('Deploy') {
            steps {
                script {
                    powershell '''
                        Write-Host "♻️ Stopping and removing old container if it exists..."
                        $containerExists = docker ps -a -q -f "name=$env:MAIN_CONTAINER"
                        if ($containerExists) {
                            docker stop $env:MAIN_CONTAINER | Out-Null
                            docker rm -f $env:MAIN_CONTAINER | Out-Null
                            Write-Host "🧹 Old container stopped and removed."
                        } else {
                            Write-Host "ℹ️ No old container found. Proceeding with deployment."
                        }

                        Write-Host "🚀 Starting new container from the freshly built image..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose up -d rccl_vallam-website   # 👈 explicitly start this service

                        Start-Sleep -Seconds 10

                        $mainContainer = docker ps -q -f "name=$env:MAIN_CONTAINER"
                        if (-not $mainContainer) {
                            Write-Error "❌ Main application container ($env:MAIN_CONTAINER) not found after deployment."
                            docker ps -a
                            exit 1
                        }

                        Write-Host "✅ Application deployed successfully!"
                        Write-Host "📦 Container ID: $mainContainer"
                        docker logs $mainContainer --tail=50
                        docker ps
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                def buildResult = currentBuild.result ?: 'SUCCESS'
                def statusClass = buildResult == 'SUCCESS' ? 'success' : (buildResult == 'FAILURE' ? 'failure' : 'warning')
                def statusIcon = buildResult == 'SUCCESS' ? '✅' : (buildResult == 'FAILURE' ? '❌' : '⚠️')
                def titleText = buildResult == 'SUCCESS' ? 'Deployment Report' : 'Build Failed Report'

                emailext(
                    subject: "${statusIcon} RCCL Vallam Project - Build ${env.BUILD_NUMBER} | ${buildResult}",
