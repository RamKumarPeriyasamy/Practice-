        }

        success {
            powershell '''
                Write-Host "✅ Pipeline completed successfully!"
                Write-Host "Build Number: $env:BUILD_NUMBER"
                Write-Host "Website URL: $env:WEBSITE_URL"
                Write-Host "Triggered by: $env:author"
