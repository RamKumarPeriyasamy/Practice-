            <div class="status-badge ${statusClass}" style="display:inline-block; padding:12px 25px; border-radius:30px; font-weight:700; font-size:15px; margin:20px 0; text-transform:uppercase; letter-spacing:1px; 
                ${buildResult == 'SUCCESS' ? 'background:rgba(255,255,255,0.2); color:white; border:2px solid rgba(255,255,255,0.3);' : 
                  buildResult == 'FAILURE' ? 'background:rgba(220,53,69,0.9); color:white; border:2px solid rgba(220,53,69,0.3);' : 
                  'background:rgba(255,193,7,0.9); color:#2c3e50; border:2px solid rgba(255,193,7,0.3);'}">
