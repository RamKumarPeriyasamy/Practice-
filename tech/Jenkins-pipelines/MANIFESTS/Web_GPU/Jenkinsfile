pipeline {
    agent {
        label 'remote-server-agent'
    }

    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref', value: '$.ref'],
                [key: 'commit', value: '$.after'],
                [key: 'author', value: '$.commits[0].author.name']
            ],
            causeString: 'Triggered by commit on $ref by $author',
            token: 'WebGPULive2211',
            printContributedVariables: true,
            printPostContent: true,
            regexpFilterText: '$ref',
            regexpFilterExpression: '^refs/heads/Updated$'
        )
    }

    environment {
        GIT_CREDENTIALS = credentials('ramkumarp')
        DOCKER_COMPOSE = 'docker-compose'
        APP_NAME = 'webgpu-3d-engine'
        MAIN_CONTAINER = 'webgpu-app'
        SONAR_HOST_URL = 'http://127.0.0.0:12345'
        SONAR_TOKEN = credentials('sonarqube-token')
        SMTP_CREDENTIALS = credentials('smtp-credentials-gmail')
        WEBSITE_URL = 'https://127.0.0.0:5505'
    }

    stages {
        stage('Source') {
            steps {
                cleanWs(deleteDirs: true, disableDeferredWipeout: true)
                script {
                    powershell '''
                        Write-Host "Starting WebGPU application source stage..."
                    '''
                    
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/Updated']],
                        userRemoteConfigs: [[
                            url: 'http://127.0.0.0:7778/Core-Engine/Web_GPU_Live.git',
                            credentialsId: env.GIT_CREDENTIALS
                        ]]
                    ])
                    
                    powershell '''
                        Write-Host "Source checkout completed successfully"
                        Write-Host "Project structure:"
                        dir
                        
                        if (Test-Path "Example/AllData/index.html") {
                            Write-Host "✅ Main HTML file found"
                        } else {
                            Write-Warning "❌ Main HTML file not found"
                        }
                        
                        if (Test-Path "Example/AllData/AllData.js") {
                            Write-Host "✅ Main JavaScript file found"
                        } else {
                            Write-Warning "❌ Main JavaScript file not found"
                        }
                        
                        if (Test-Path "src") {
                            Write-Host "✅ Source directory found"
                        } else {
                            Write-Warning "❌ Source directory not found"
                        }
                        
                        # Check for critical shader files
                        if (Test-Path "src/shaders/shaders.wgsl") {
                            Write-Host "✅ WebGPU shader file found"
                        } else {
                            Write-Error "❌ CRITICAL: WebGPU shader file (src/shaders/shaders.wgsl) not found!"
                            Write-Host "This file is required for WebGPU rendering pipeline"
                            exit 1
                        }
                        
                        # Check for GLTF model
                        if (Test-Path "src/asset/Gltf/gas cylinder.gltf") {
                            Write-Host "✅ Gas cylinder GLTF model found"
                        } else {
                            Write-Warning "❌ Gas cylinder GLTF model not found"
                        }
                    '''
                }
            }
        }

        stage('Shader Validation') {
            steps {
                script {
                    powershell '''
                        Write-Host "Validating WebGPU shaders..."
                        
                        if (Test-Path "src/shaders/shaders.wgsl") {
                            $shaderContent = Get-Content "src/shaders/shaders.wgsl" -Raw
                            $shaderSize = $shaderContent.Length
                            Write-Host "Shader file size: $shaderSize bytes"
                            
                            if ($shaderContent -match "@vertex") {
                                Write-Host "✅ Vertex shader entry point found"
                            } else {
                                Write-Error "❌ Vertex shader entry point missing"
                            }
                            
                            if ($shaderContent -match "@fragment") {
                                Write-Host "✅ Fragment shader entry point found"
                            } else {
                                Write-Error "❌ Fragment shader entry point missing"
                            }
                            
                            if ($shaderContent -match "main_vertex") {
                                Write-Host "✅ main_vertex function found"
                            } else {
                                Write-Error "❌ main_vertex function missing"
                            }
                            
                            if ($shaderContent -match "main_fragment") {
                                Write-Host "✅ main_fragment function found"
                            } else {
                                Write-Error "❌ main_fragment function missing"
                            }
                        } else {
                            Write-Error "Shader file not found!"
                            exit 1
                        }
                        
                        Write-Host "Shader validation completed"
                    '''
                }
            }
        }

        stage('SSL Setup') {
            steps {
                script {
                    powershell '''
                        Write-Host "Checking SSL certificates..."
                        
                        if ((Test-Path "cert.pem") -and (Test-Path "key.pem")) {
                            Write-Host "✅ SSL certificates already exist"
                        } else {
                            Write-Warning "❌ SSL certificates not found"
                            Write-Host "Note: Nginx configuration expects cert.pem and key.pem"
                            Write-Host "Please ensure certificates are present in the repository"
                        }
                        
                        Write-Host "SSL setup completed"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    powershell '''
                        Write-Host "Cleaning existing WebGPU Docker resources..."
                        
                        $containerExists = docker ps -a -q -f name="$env:MAIN_CONTAINER"
                        if ($containerExists) {
                            Write-Host "Stopping and removing existing container: $env:MAIN_CONTAINER"
                            docker stop $env:MAIN_CONTAINER
                            docker rm $env:MAIN_CONTAINER
                        } else {
                            Write-Host "Container $env:MAIN_CONTAINER not found, skipping stop and remove."
                        }
                        
                        $imageExists = docker images -q "$env:APP_NAME"
                        if ($imageExists) {
                            Write-Host "Removing existing image: $env:APP_NAME"
                            docker rmi $env:APP_NAME --force
                        }
                        
                        Write-Host "Currently existing containers:"
                        docker ps -a
                        
                        Write-Host "Current directory contents:"
                        dir
                    '''
                    
                    powershell '''
                        Write-Host "Building WebGPU application with Docker Compose..."
                        
                        if (-not (Test-Path "docker-compose.yaml")) {
                            Write-Error "docker-compose.yaml not found!"
                            exit 1
                        }
                        
                        if (-not (Test-Path "Dockerfile")) {
                            Write-Error "Dockerfile not found!"
                            exit 1
                        }
                        
                        if (-not (Test-Path "nginx.conf")) {
                            Write-Error "nginx.conf not found!"
                            exit 1
                        }
                        
                        Write-Host "All required files found. Starting build..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker-compose build --no-cache
                        
                        Write-Host "Build completed. Listing images:"
                        docker images | Select-String "webgpu"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    powershell '''
                        Write-Host "Deploying WebGPU application with Docker Compose..."
                        $env:COMPOSE_CONVERT_WINDOWS_PATHS=1
                        docker compose up -d
                        
                        Write-Host "Waiting for container to start..."
                        Start-Sleep -Seconds 15
                        
                        $mainContainer = docker ps -q -f name="$env:MAIN_CONTAINER"
                        if (-not $mainContainer) {
                            Write-Error "Main application container ($env:MAIN_CONTAINER) not found or not running"
                            docker logs $env:MAIN_CONTAINER
                            exit 1
                        }
                        
                        Write-Host "✅ WebGPU application deployed successfully!"
                        Write-Host "Main Container ID: $mainContainer"
                        
                        Write-Host "Container Logs:"
                        docker logs $mainContainer --tail 20
                        
                        Write-Host "Currently running containers:"
                        docker ps
                        
                        Write-Host "Testing application accessibility..."
                        try {
                            $response = Invoke-WebRequest -Uri "${env.WEBSITE_URL}" -SkipCertificateCheck -TimeoutSec 30
                            Write-Host "✅ Application is accessible on HTTPS port 5505"
                            Write-Host "Response status: $($response.StatusCode)"
                        } catch {
                            Write-Warning "Could not verify HTTPS accessibility: $($_.Exception.Message)"
                        }
                        
                        Write-Host "Access your WebGPU application at:"
                        Write-Host "HTTPS: ${env.WEBSITE_URL}"
                        Write-Host "Local: https://localhost:5505"
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    powershell '''
                        Write-Host "Performing WebGPU application health check..."
                        
                        $containerStatus = docker inspect --format='{{.State.Status}}' $env:MAIN_CONTAINER
                        Write-Host "Container Status: $containerStatus"
                        
                        if ($containerStatus -ne "running") {
                            Write-Error "Container is not running properly"
                            docker logs $env:MAIN_CONTAINER
                            exit 1
                        }
                        
                        $portCheck = docker exec $env:MAIN_CONTAINER netstat -tlnp | Select-String ":5505"
                        if ($portCheck) {
                            Write-Host "✅ Port 5505 is listening inside container"
                        } else {
                            Write-Warning "❌ Port 5505 might not be listening"
                        }
                        
                        $nginxProcess = docker exec $env:MAIN_CONTAINER ps aux | Select-String "nginx"
                        if ($nginxProcess) {
                            Write-Host "✅ Nginx is running"
                        } else {
                            Write-Warning "❌ Nginx process not found"
                        }
                        
                        $shaderCheck = docker exec $env:MAIN_CONTAINER test -f "/usr/share/nginx/html/src/shaders/shaders.wgsl"
                        if ($LASTEXITCODE -eq 0) {
                            Write-Host "✅ Shader files accessible in container"
                        } else {
                            Write-Warning "❌ Shader files not accessible in container"
                        }
                        
                        Write-Host "🚀 WebGPU 3D Engine Health Check Complete!"
                        Write-Host "Application Status: HEALTHY"
                        
                        docker stats --no-stream $env:MAIN_CONTAINER
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    powershell '''
                        Write-Host "Generating sonar-project.properties..."
                        $sonarProps = @"
sonar.projectKey=webgpu-3d-engine
sonar.projectName=webgpu-3d-engine
sonar.projectVersion=1.0.0
sonar.projectDescription=WebGPU 3D Rendering Engine
sonar.sources=./
sonar.language=js
sonar.sourceEncoding=UTF-8
sonar.javascript.lcov.reportPaths=coverage/lcov.info
"@
                        Set-Content -Path "sonar-project.properties" -Value $sonarProps
                        Write-Host "Running SonarScanner..."
                        sonar-scanner
                    '''
                }
            }
        }
    }

